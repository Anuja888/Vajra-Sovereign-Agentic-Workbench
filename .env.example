# VAJRA Environment Variables
# Copy this file to .env and fill in values before starting.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────

# Port the Fastify server listens on (default: 3000)
PORT=3000

# Host to bind (use 0.0.0.0 in Docker/containers, 127.0.0.1 for local-only)
HOST=0.0.0.0

# Allowed CORS origins for the API server.
# Comma-separated list. Use * to allow all origins (not recommended in production).
# For Docker Compose: set to your frontend URL, e.g. http://localhost:80
# For Railway/Render + Vercel: set to https://your-project.vercel.app
CORS_ORIGIN=http://localhost:5173

# ── Web (build-time) ──────────────────────────────────────────────────────────

# URL the browser uses to reach the API server.
# Empty string = same origin (when using nginx to proxy /api → server).
# For Railway/Render: set to https://your-backend.railway.app
# For local Docker Compose: leave empty (nginx handles the proxy)
VITE_API_URL=

# ── Optional ──────────────────────────────────────────────────────────────────

# Node environment (development | production)
NODE_ENV=production
